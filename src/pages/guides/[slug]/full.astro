---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SituationNav from '../../../components/SituationNav.astro';
import PageToc from '../../../components/PageToc.astro';
import RelatedCards from '../../../components/RelatedCards.astro';
import PrevNext from '../../../components/PrevNext.astro';
import { adjacent, sortGuides, sortPaths } from '../../../lib/content.mjs';
import { renderMarkdown } from '../../../lib/markdown.mjs';

export async function getStaticPaths() {
  return (await getCollection('guides')).filter((entry) => !entry.data.forum_tid).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const paths = sortPaths(await getCollection('paths'));
const guides = sortGuides(await getCollection('guides'));
const { html, headings } = await renderMarkdown(entry.body);
const neighbours = adjacent(guides, entry.data.slug);
---
<Base title={`${entry.data.title}（过渡全文）`} description={entry.data.summary}>
  <div class="wrap content-page">
    <SituationNav relatedSlugs={entry.data.related_paths} />
    <header class="path-hero"><p class="eyebrow">过渡全文 · 论坛详解上线后将由摘要页直达论坛</p><h1>{entry.data.title}</h1><p class="lede">{entry.data.summary}</p></header>
    <div class="article-layout"><PageToc headings={headings} /><article class="prose" set:html={html}></article></div>
    <RelatedCards data={entry.data} paths={paths} guides={guides} />
    <PrevNext {...neighbours} section="guides" />
  </div>
</Base>
